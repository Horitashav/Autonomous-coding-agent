# ==========================================
# LLM / Agent Orchestrator API Keys
# ==========================================
GROQ_API_KEY=your_groq_api_key_here

# Optional: If you use or plan to switch to OpenAI or Anthropic models in LangGraph
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ==========================================
# PostgreSQL Database Configuration
# ==========================================
POSTGRES_USER=agent_admin
POSTGRES_PASSWORD=agent_secret_password
POSTGRES_DB=agent_production_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://agent_admin:agent_secret_password@localhost:5432/agent_production_db

# ==========================================
# Authentication & Security
# ==========================================
# A secure 32+ byte random secret used to sign JWT session tokens
JWT_SECRET_KEY=agent_production_super_secret_jwt_key_2026_change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# Environment / Runtime
# ==========================================
ENVIRONMENT=development
PORT=8000